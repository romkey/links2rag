# Every environment variable this project uses, with dummy values. Copy to
# .env (gitignored) and fill in real values there; never in this file.
# docs/configuration.md says what each one does. Names shared with the
# pipeline's other ingesters mean the same thing there.

# --- Asset manager (required) ------------------------------------------------

# Where the ingester reaches the asset manager (pdxhackerspace-links).
LINKS_URL=http://links:3000
# A dedicated API key from Settings -> API keys in the asset manager. The API
# is read-only; create a key just for this ingester so it can be revoked alone.
LINKS_API_KEY=links_REPLACE_ME
# Base of the links stored with each point; defaults to LINKS_URL.
# LINKS_PUBLIC_URL=https://links.example.com
# Things per page (at most 500), and the timeout per request.
# LINKS_PAGE_SIZE=500
# REQUEST_TIMEOUT_SECONDS=60
# Things imported by these integrations are indexed too (comma-separated:
# unifi, zigbee2mqtt, prusa_connect). By default imported things are staged
# but not indexed: they are network infrastructure, sensors in the access
# path, or members' own devices.
# INCLUDE_INTEGRATION_SOURCES=prusa_connect
# Owner values that mean the space owns a thing (case-insensitive). A blank
# owner counts as the space. Any other owner is indexed only as "on loan
# from a member"; the name never is.
# SPACE_OWNER_NAMES=PDX Hackerspace,PDXHackerspace,Hackerspace,CTRLH,space
# The geowiki's base URL: "Where" links to it become location IDs.
# GEOWIKI_URL=https://geowiki.example.com
# Hosts never fetched for manuals (comma-separated), in addition to the asset
# manager and geowiki. Use it for the wiki and Slack, which other ingesters index.
# SKIP_LINK_HOSTS=wiki.example.com,example.slack.com

# --- PostgreSQL: staging store and entity registry ---------------------------

# The pipeline's shared database: the same one the other ingesters use. The
# compose files set it to their own db service in development and tests.
DATABASE_URL=postgresql://app:REPLACE_ME@db:5432/app
# Used by docker-compose.prod.yaml's db service (not read by the app).
POSTGRES_USER=app
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=app

# --- Qdrant ------------------------------------------------------------------

# The pipeline's shared Qdrant. The compose files set it to their own service.
# QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=REPLACE_ME
# Member-tier collection. This ingester never writes to hs_public.
# QDRANT_MEMBER_COLLECTION=hs_member
# cosine, dot or euclid; used only when creating a collection.
QDRANT_DISTANCE=cosine
# Must match the embedding model's dimension (modernbert-embed-base: 768).
VECTOR_SIZE=768

# --- Embeddings ----------------------------------------------------------------

# openai (an OpenAI-compatible embeddings API, the pipeline's gateway) or
# sentence_transformers (needs the sentence-transformers extra). Use the same
# model and prefixes as the pipeline's other ingesters: they share collections.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=nomic-ai/modernbert-embed-base
OPENAI_BASE_URL=http://localhost:8080/v1
# Leave unset for local servers that don't need auth.
# OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_TIMEOUT_SECONDS=120
# Reduced-size vectors (text-embedding-3-* only); must match VECTOR_SIZE.
# EMBEDDING_DIMENSIONS=512
# Model context in tokens; longer texts (~4 chars/token) are truncated. 0 disables.
EMBEDDING_CONTEXT_LENGTH=8192
# Task prefixes for ModernBERT and nomic-embed-text. Double quotes keep the
# trailing space. Changing the document prefix changes every vector.
EMBEDDING_QUERY_PREFIX="search_query: "
EMBEDDING_DOCUMENT_PREFIX="search_document: "
# Hugging Face model cache for sentence_transformers. The first one set wins.
# HF_CACHE_DIR=/hf-cache
# SENTENCE_TRANSFORMERS_HOME=/hf-cache
# HF_HOME=/hf-cache

# --- Generation (ingest-time LLM tasks) ---------------------------------------

# Chat model for asset descriptions, topics, manual chunk context and section
# kinds, nickname proposals and linker checks, through the gateway. Unset:
# those steps are skipped. Base URL and key default to OPENAI_BASE_URL and
# OPENAI_API_KEY.
# LLM_MODEL=qwen3-30b-a3b
# LLM_BASE_URL=http://gateway:4000/v1
# LLM_API_KEY=REPLACE_ME
# LLM_TIMEOUT_SECONDS=120
# Vision model for short descriptions of manual pages that are mostly a
# diagram. Unset: diagram pages are indexed by their text only.
# VISION_MODEL=qwen2.5-vl-7b
# Topic taxonomy file (one slug per line); default: the copy in the package.
# TOPIC_TAXONOMY_FILE=/config/taxonomy.txt

# --- Manuals ---------------------------------------------------------------

# Download, parse and index the manuals things link to.
# MANUALS_ENABLED=true
# Custom links whose title or URL matches this (case-insensitive regex) are
# manuals. Default: manual, datasheet, user guide, guide, instructions,
# handbook, documentation, or a .pdf URL.
# MANUAL_LINK_PATTERN=manual|datasheet|\.pdf$
# Also look one level into each thing's manufacturer link for manual PDFs.
# MANUALS_FROM_MANUFACTURER_URL=true
# Days before a manual is downloaded again (sooner if its link changes).
# MANUAL_REFETCH_DAYS=7
# Largest file downloaded, in MB.
# MANUAL_MAX_MB=50
# Manuals placed by hand: a directory of files, each with a <file>.yaml or
# <file>.json sidecar naming the asset keys it belongs to.
# MANUALS_DIR=/manuals
# Where downloaded manuals and reports are kept. Mount a volume here.
# DATA_DIR=/data
# Fetch manual links on private, loopback and link-local addresses (the
# space's own servers). Set false to fetch only hosts with public addresses.
# ALLOW_PRIVATE_HOSTS=true
# OCR scanned PDFs (pages with no text layer) with tesseract.
# OCR_ENABLED=true
# OCR_LANGUAGE=eng

# --- Chunking and batching -------------------------------------------------

# About 450 tokens; the hard cap is the embedding context length.
CHUNK_SIZE=1800
CHUNK_OVERLAP=150
BATCH_SIZE=64

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# --- Scheduling (the default `serve` command) ------------------------------
# Minutes to sleep between scans, >= 1.
SCAN_INTERVAL_MINUTES=60
# A scan is a full one (which also reconciles deletions by run ID) when no
# full scan has finished in this many hours, >= 1; otherwise incremental.
FULL_SCAN_INTERVAL_HOURS=24
# true: serve's first scan restages, re-downloads and re-embeds everything.
# Set it back to false afterwards.
FORCE_REINDEX=false

# --- Compose (not read by the app) -----------------------------------------

# Release of the image docker-compose.prod.yaml runs; default latest.
# APP_VERSION=0.1.0

# --- Publishing to PyPI (optional; not read by the app) --------------------
# Only for publishing by hand from your machine (`uv publish`); releases
# from GitHub use trusted publishing or the PYPI_API_TOKEN repository
# secret instead; see
# https://github.com/romkey/python-ai-rules/blob/main/docs/releasing.md
# A project-scoped API token from https://pypi.org/manage/account/token/. Keep it out of
# .env on servers: compose passes .env to the app.
# UV_PUBLISH_TOKEN=pypi-REPLACE_ME
